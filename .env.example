# Copy to .env and fill in. NEVER commit the real .env - it is gitignored.

# --- LinkedIn session -------------------------------------------------------
# Preferred: the whole Cookie header from a logged-in browser.
#   DevTools -> Network -> click any request -> Copy as cURL -> the -b '...' value
# A browser sends ~25 cookies; sending only two is a fingerprint that gets the
# session challenged. Only the cookies that matter are forwarded.
LINKEDIN_COOKIE=

# Alternative, if you would rather supply the two individually.
# JSESSIONID looks like ajax:1234567890123456789 - paste it WITHOUT quotes.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# --- Modes ------------------------------------------------------------------
# Serve a committed sample instead of calling LinkedIn. Lets the schema be
# exercised with no credentials at all.
DEMO_MODE=false
# Also read the logged-out public page. It carries the about text, photo and
# schools that the authenticated page omits for out-of-network members.
ENABLE_PUBLIC_FALLBACK=true

# --- API auth ---------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header.
# Empty disables auth (local development only) - always set it when deployed.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- Tuning -----------------------------------------------------------------
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512
RATE_LIMIT_PER_MINUTE=20
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=2
INTER_REQUEST_DELAY_SECONDS=0.6
# Hard cap on concurrent calls to LinkedIn, however many callers we serve.
MAX_UPSTREAM_CONCURRENCY=1
